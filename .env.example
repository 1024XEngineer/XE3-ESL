# 本地配置模板：复制为 .env 使用，不要提交密钥。
POSTGRES_DB=xe3_esl
POSTGRES_USER=xe3_esl
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

DATABASE_URL=postgres://xe3_esl:local-development-only@127.0.0.1:5432/xe3_esl?sslmode=disable
MIGRATION_ENV=local

# Internal Prometheus scrape listener. Keep it on loopback unless deployment
# places it on a private container network without publishing the port.
METRICS_HOST=127.0.0.1
METRICS_PORT=9090

# 阿里云：LLM（完整模考使用 strict JSON Schema）
TEXT_GENERATION_PROVIDER=qianwen
AGENT_CONTEXT_MAX_CHARACTERS=12000
# End-to-end Agent tool loop budget; must exceed the selected text provider timeout.
AGENT_RUN_LOOP_TIMEOUT=150s
DASHSCOPE_API_KEY=

QIANWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QIANWEN_MODEL=qwen3.7-plus
QIANWEN_EVALUATION_MODEL=qwen3.7-plus
QIANWEN_SPEECH_FEEDBACK_MODEL=qwen3.7-plus
QIANWEN_TIMEOUT=60s
QIANWEN_MAX_OUTPUT_TOKENS=8192

# 七牛云：备用 LLM、多模态（MaaS）
QINIU_AI_BASE_URL=https://api.qnaigc.com/v1
QINIU_AI_MODEL=moonshotai/kimi-k2.6
# Evaluation stays independent from the latency-oriented Agent model above;
# this model passed the opt-in strict IELTS contract check. Replace it only
# after the candidate also passes that check within the provider timeout.
QINIU_AI_EVALUATION_MODEL=qwen3-30b-a3b-instruct-2507
QINIU_AI_SPEECH_FEEDBACK_MODEL=gemini-2.5-flash
QINIU_AI_TIMEOUT=60s
QINIU_AI_MAX_OUTPUT_TOKENS=8192
QINIU_AI_API_KEY=

# Explicit opt-in for a local real-provider test; public CI leaves this disabled.
# Enabling it sends a real request and may incur charges.
QIANWEN_LIVE_TEST=0

# 阿里云：ASR（千问）
SPEECH_RECOGNITION_PROVIDER=qianwen
QIANWEN_ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QIANWEN_ASR_MODEL=fun-asr-realtime
QIANWEN_ASR_TIMEOUT=150s
QIANWEN_ASR_RECORDED_MODEL=fun-asr-flash-2026-06-15
QIANWEN_ASR_RECORDED_TIMEOUT=150s

# 阿里云：TTS（千问）
SPEECH_SYNTHESIS_PROVIDER=qianwen
QIANWEN_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
QIANWEN_TTS_MODEL=qwen-audio-3.0-tts-flash
QIANWEN_TTS_VOICE=loongeva_v3.6
QIANWEN_TTS_LANGUAGE=en
QIANWEN_TTS_TIMEOUT=60s
QIANWEN_TTS_TEMP_DIRECTORY=

# Process-local unconfirmed audio budget. Admission is fail-fast and reserves
# the maximum upload size before reading the body, with a per-user fairness cap.
VOICE_TEMP_AUDIO_LIFETIME=2m
VOICE_TEMP_AUDIO_MAX_ITEMS=4
VOICE_TEMP_AUDIO_MAX_BYTES=33554432
VOICE_TEMP_AUDIO_MAX_ITEMS_PER_USER=1
VOICE_TEMP_AUDIO_MAX_BYTES_PER_USER=8388608
VOICE_TEMP_AUDIO_MAX_CONCURRENT_CAPTURES=2
VOICE_TEMP_AUDIO_MAX_CONCURRENT_CAPTURES_PER_USER=1
VOICE_AUDIO_READ_TIMEOUT=15s
VOICE_RECORDED_AUDIO_READ_TIMEOUT=60s

# Real voice calls are separate, explicit local opt-ins. The ASR fixture must
# be a non-sensitive PCM WAV that meets the upload limits above. Enabling
# either live flag sends a real Provider request and may incur charges.
QIANWEN_ASR_LIVE_TEST=0
QIANWEN_ASR_LIVE_TEST_AUDIO=
QIANWEN_TTS_LIVE_TEST=0

# 讯飞：口语评测（ISE）
APPID=
APIKey=
APISecret=
XFYUN_ISE_ENDPOINT=wss://ise-api.xfyun.cn/v2/open-ise
XFYUN_ISE_TIMEOUT=150s
XFYUN_ISE_LIVE_TEST=0
XFYUN_ISE_LIVE_TEST_AUDIO=
XFYUN_ISE_LIVE_TEST_TEXT=

# SpatialWalk：数字人

# 阿里云：对象存储（OSS）
OSS_ENABLED=0
OBJECT_STORAGE_PROVIDER=aliyun_oss
OSS_REGION=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_CREDENTIALS_PROVIDER=ecs_role
OSS_RAM_ROLE_NAME=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
OSS_AUDIO_PREFIX=audio/v1
OSS_IMAGE_PREFIX=image/v1
OSS_RESUME_PREFIX=resume/v1
OSS_SIGNED_URL_TTL=2m

# 七牛云：对象存储（Kodo S3）
QINIU_KODO_S3_REGION=cn-east-1
QINIU_KODO_S3_ENDPOINT=https://s3.cn-east-1.qiniucs.com
QINIU_KODO_S3_BUCKET=
QINIU_KODO_SERVER_SIDE_ENCRYPTION=0
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=

# 百度智能云：简历 OCR（PaddleOCR）
RESUME_OCR_ENABLED=0
PADDLEOCR_ACCESS_TOKEN=
PADDLEOCR_BASE_URL=https://paddleocr.aistudio-app.com
RESUME_OCR_TIMEOUT=2m
RESUME_OCR_LIVE_TEST=0
RESUME_OCR_LIVE_TEST_PDF=

# Explicit opt-in for a real Put -> signed Get -> Delete provider test.
# `make check-oss-live` intentionally does not load or execute .env. Export the
# required OSS_* variables in the current shell before running it. Public CI
# and ordinary local checks leave this disabled.
OSS_LIVE_TEST=0
KODO_LIVE_TEST=0
# Optional Practice digital-human provider. The iOS simulator launcher always
# overrides the client capability to disabled.
SPATIUS_ENABLED=false
SPATIUS_REGION=ap-northeast
SPATIUS_APP_ID=
SPATIUS_AVATAR_ID=
SPATIUS_API_KEY=
