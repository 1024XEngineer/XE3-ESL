# Raw KEY=value configuration. Do not use shell expressions or quote values.
# Copy this file outside the repository and keep it mode 0600.
# Set this to the existing Certbot configuration root when expanding Production.
TLS_CERTBOT_CONFIG_ROOT=/opt/xe3-speakup-portal/certbot/conf
TLS_STAGING_ACME_ROOT=/var/www/staging-acme
TLS_PRODUCTION_ACME_ROOT=/opt/xe3-speakup-portal/certbot/www
TLS_STATE_ROOT=/var/lib/speakup/tls
TLS_NGINX_BINARY=/usr/local/nginx/sbin/nginx
