          "rawQuery": true,
          "rawSql": "SELECT day_utc AS time,\n       max(scheduled_coverage_rate) FILTER (WHERE artifact_kind = 'TURN_FEEDBACK') AS \"Turn feedback scheduled\",\n       max(ready_coverage_rate) FILTER (WHERE artifact_kind = 'TURN_FEEDBACK') AS \"Turn feedback READY\",\n       max(scheduled_coverage_rate) FILTER (WHERE artifact_kind = 'SESSION_REPORT') AS \"Session report scheduled\",\n       max(ready_coverage_rate) FILTER (WHERE artifact_kind = 'SESSION_REPORT') AS \"Session report READY\"\nFROM public.product_health_daily_artifact_coverage\nWHERE $__timeFilter(day_utc)\nGROUP BY day_utc\nORDER BY day_utc",
